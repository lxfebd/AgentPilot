# Node
node_modules/

# Dependency lockfiles are intentionally not committed in this repo.
# Cross-platform package managers rewrite them frequently, creating noise.
uv.lock
yarn.lock
package-lock.json
pnpm-lock.yaml

# Local Claude tooling (launch.json, transcripts, worktree metadata)
.claude/
.codex-run/
# Local editor/agent project marker (per-machine UUID)
.freebuff/
agent-server/*-review.html

# Local scratch directory for an unrelated AMD-account side project
# (contains credentials and vendored third-party packages; never committed).
amd-proxy/

# Local runtime state
.local-dev/
*.sqlite
*.sqlite3
*.db
agent-server/agent-server.files/

# Downloaded uv binaries and CPython builds bundled into the packaged Desktop apps.
